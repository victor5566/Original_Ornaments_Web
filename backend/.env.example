# Port for npm run serve (production: client/build). The dev server's port is in client/.env.
SERVE_PORT=3000

# PostgreSQL (local, WSL). The site's own account: reads the catalog, writes orders.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ooweb
PGUSER=ooweb_app
PGPASSWORD=

# Order confirmation email (optional; without SMTP_HOST the email is only written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the site, for the order link in the email
SITE_URL=

# PayPal (developer.paypal.com > Apps & Credentials). PAYPAL_ENV: sandbox or live; the keys must match it.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The Webhook ID shown after adding https://<site>/api/paypal/webhook to the app's webhooks
PAYPAL_WEBHOOK_ID=
# Unpaid PayPal orders are cancelled after this many hours
UNPAID_ORDER_HOURS=24
