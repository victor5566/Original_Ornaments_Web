# Port for npm run serve (production: client/build). The dev server's port is in client/.env.
SERVE_PORT=3000

# PostgreSQL (local, WSL). The site's own account: reads the catalog, writes orders.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ooweb
PGUSER=ooweb_app
PGPASSWORD=

# Order confirmation email (optional; without SMTP_HOST the email is only written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the site, for the order link in the email
SITE_URL=
